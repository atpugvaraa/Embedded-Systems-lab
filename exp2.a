; 2(a)
    AREA PROGRAM, CODE, READONLY
    ENTRY
MAIN
    LDR R1, VALUE
    MOV R3, R1, LSL #2
    AREA PROGRAM, DATA, READONLY
    VALUE DCD &3000F000
    END

; 2(b)
    AREA PROGRAM, CODE, READONLY
    ENTRY
MAIN
    LDR R1, VALUE
    MOV R2, #4
    MOV R3, R1, LSR R2
    AREA PROGRAM, DATA, READONLY
    VALUE DCD &3000F000
    END

; 2(c)
    AREA PROGRAM, CODE, READONLY
    ENTRY
MAIN
    LDR R1, VALUE
    MOVS R3, $0
    MOVEQ R3, R1, LSL #3
    AREA PROGRAM, DATA, READONLY
    VALUE DCD &3000F000
    END

; 2(d)
    AREA PROGRAM, CODE, READONLY
    ENTRY
MAIN
    LDR R1, VALUE
    MOV R2, #5
    MOV R3, R1, ASR R2
    AREA PROGRAM, DATA, READONLY
    VALUE DCD &3000F000
    END

; 2(e)
    AREA PROGRAM, CODE, READONLY
    ENTRY
MAIN
    LDR R1, VALUE1
    LDR R2, VALUE2
    MOV R3, R2, LSL #2
    ADD R4, R1, R3
    AREA PROGRAM, DATA, READONLY
    VALUE DCD &00001234
    VALUE1 DCD &0000FFFF
    END
