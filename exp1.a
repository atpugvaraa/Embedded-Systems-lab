; 1 (a)

		AREA    PROGRAM, CODE, READONLY
        ENTRY

MAIN
        MOV     R1, #0X12
        MOV     R2, R1
        MOV     R3, R1
		END


 ; 1 (b)

  		AREA    PROGRAM, CODE, READONLY
        ENTRY

MAIN
		MOV	R1, #0X12
		MOV	R2, #0X15
		ADD		R4,  R1, R2
		END

; 1 (c)

  		AREA    PROGRAM, CODE, READONLY
        ENTRY

MAIN
		LDR		R1, VALUE1
		LDR 		R2, VALUE2
		ADD 	R3, R1, R2
		AREA	PROGRAM, DATA, READONLY
		VALUE1 DCD, &00000012
		VALUE2 DCD, &00000013
		END

; 1 (d)

		AREA	PROGRAM, CODE, READONLY
		ENTRY

MAIN
		LDR R1, VALUE1
		LDR R2, VALUE2
		LDR R3, [R1]
		LDR R4, [R2]
		ADD R6, R4, R3
		AREA	PROGRAM, DATA, READONLY
		VALUE1 DCD, &00001000
		VALUE2 DCD, &00001004
		END

; 1 (e)

		AREA	PROGRAM, CODE, READONLY
		ENTRY

MAIN
		MOV R1, #0X12
		MVN R2, R1
		END
